# packaging/docker/runtime/Dockerfile.base
#
# Shared base for all Multica agent runtime images: the `multica` binary plus
# full polyglot toolchains (Go, Rust + cargo-ndk, ESP32 Xtensa cross-compile
# (esp toolchain + ESP-IDF), Node/pnpm, JDK/Kotlin, Android SDK + NDK,
# Python, protobuf/protoc + Go & Rust codegen plugins,
# Terraform + a pre-baked Cloudflare provider) and the debuggers/linters agents need at
# runtime. Per-provider images (Dockerfile.claude, etc.) extend this and
# add their agent CLI.
#
# Tradeoff: this is a fat image (~8-10 GB) on purpose. Once a node has the
# layers cached, pod startup is unaffected and agents working on polyglot
# repos (Go + Rust + Svelte + Kotlin + Android) don't need to install
# tooling per-job.
#
# Version pins for the language toolchains live in packaging/*-version text
# files and are passed in as --build-arg by packaging/scripts/build-images.sh.
# The ARGs have no defaults so an unpinned build fails loudly — matches the
# CLAUDE_CODE_VERSION pattern in Dockerfile.claude.

ARG GO_VERSION=1.26.4

# ── Build the multica binary from source ──────────────────────────────
FROM golang:${GO_VERSION}-bookworm AS multica-build
WORKDIR /src
COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download
COPY server/ ./server/
ARG VERSION=dev
ARG COMMIT=unknown
RUN cd server && CGO_ENABLED=0 go build \
      -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
      -o /out/multica ./cmd/multica

# ── Runtime base ──────────────────────────────────────────────────────
# node:22-trixie (Debian 13). The earlier node:22-bookworm base shipped a
# stale debian-archive keyring that didn't include Debian's mid-2026 archive
# signing key rotation, so `apt-get update` failed with "At least one
# invalid signature was encountered" on every build. Trixie is the current
# Debian stable and ships fresh keys.
FROM node:22-trixie

# Strict pins — build-images.sh passes these from packaging/*-version.
ARG RUST_VERSION
ARG KOTLIN_VERSION
ARG GOLANGCI_LINT_VERSION
ARG KTLINT_VERSION
ARG PNPM_VERSION
ARG KUBECTL_VERSION
ARG HELM_VERSION
ARG GH_VERSION
ARG WRANGLER_VERSION
ARG RCLONE_VERSION
ARG PROTOC_VERSION
ARG TERRAFORM_VERSION
ARG TERRAFORM_CLOUDFLARE_PROVIDER_VERSION
# Android SDK/NDK component versions don't need a per-file pin (they rarely
# bump). Defaults stay in-Dockerfile and can be overridden via --build-arg.
ARG ANDROID_CMDLINE_TOOLS_VERSION=13114758
ARG ANDROID_PLATFORM_VERSION=36
ARG ANDROID_BUILD_TOOLS_VERSION=36.0.0
ARG ANDROID_NDK_VERSION=27.2.12479018
ARG CARGO_NDK_VERSION=3.5.4
RUN test -n "$RUST_VERSION"             || { echo "RUST_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$KOTLIN_VERSION"        || { echo "KOTLIN_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$GOLANGCI_LINT_VERSION" || { echo "GOLANGCI_LINT_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$KTLINT_VERSION"        || { echo "KTLINT_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$PNPM_VERSION"          || { echo "PNPM_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$KUBECTL_VERSION"       || { echo "KUBECTL_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$HELM_VERSION"          || { echo "HELM_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$GH_VERSION"            || { echo "GH_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$WRANGLER_VERSION"      || { echo "WRANGLER_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$RCLONE_VERSION"        || { echo "RCLONE_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$PROTOC_VERSION"        || { echo "PROTOC_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$TERRAFORM_VERSION"     || { echo "TERRAFORM_VERSION build arg is required" >&2; exit 1; } \
    && test -n "$TERRAFORM_CLOUDFLARE_PROVIDER_VERSION" || { echo "TERRAFORM_CLOUDFLARE_PROVIDER_VERSION build arg is required" >&2; exit 1; }

# Base apt packages: VCS, SSH, build/debug tooling, common dev utilities,
# JDK 21 for Kotlin/Android Gradle Plugin 8.x. (Trixie doesn't ship a JDK 17
# headless package; AGP 8.x is documented to run on JDK 21, and Kotlin
# requires only JDK 11+. JDK 17 source/target levels still build on JDK 21.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      openssh-client \
      ca-certificates \
      gnupg \
      python3 \
      python3-pip \
      python3-venv \
      python-is-python3 \
      build-essential \
      pkg-config \
      make \
      cmake \
      ripgrep \
      fd-find \
      bat \
      curl \
      wget \
      jq \
      unzip \
      zip \
      gdb \
      lldb \
      strace \
      ltrace \
      lsof \
      procps \
      psmisc \
      netcat-openbsd \
      dnsutils \
      iputils-ping \
      net-tools \
      tcpdump \
      socat \
      tmux \
      vim-tiny \
      less \
      tree \
      file \
      htop \
      sudo \
      openjdk-21-jdk-headless \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && ln -sf /usr/bin/batcat /usr/local/bin/bat \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# ── Ham-radio digital-mode vector-generator build deps ────────────────
# Two independent toolchains for building the reference codecs that emit
# our CI known-answer test vectors (codewords/tones/wav), both file-based:
#
#   WSJT-X reference sims (FST4/FST4W + the WSJT-X track: fst4sim,
#   ldpcsim240_101/074, …) — Fortran tools linking single-precision FFTW.
#   gcc/g++/make/cmake are already in build-essential above; gfortran and
#   libfftw3-dev (ships libfftw3f) are the only additions they need.
#
#   fldigi (PSK family + the fldigi track) — an autotools + FLTK app built
#   and driven headlessly to a WAV. libsndfile/libsamplerate are its offline
#   WAV I/O + resampling (auto-detected by configure); the X/font/png/jpeg
#   libs are FLTK's transitive deps. portaudio is intentionally omitted —
#   no real audio device is ever touched. Trixie ships FLTK 1.4, so this
#   uses libfltk1.4-dev (fldigi builds against 1.3 or 1.4).
#
# libasound2-dev supplies the ALSA headers that cpal links against, which
# the omnimodemd daemon crate needs to compile (no audio device is opened
# at build time; this is a link-time dependency only).
RUN apt-get update && apt-get install -y --no-install-recommends \
      gfortran \
      libfftw3-dev \
      autoconf \
      automake \
      libtool \
      libfltk1.4-dev \
      libsndfile1-dev \
      libsamplerate0-dev \
      libx11-dev \
      libxext-dev \
      libxft-dev \
      libxfixes-dev \
      libxinerama-dev \
      libfontconfig1-dev \
      libpng-dev \
      libjpeg-dev \
      zlib1g-dev \
      libusb-1.0-0-dev \
      libhamlib-dev \
      libasound2-dev \
    && rm -rf /var/lib/apt/lists/*

# ── General C++ scientific/GUI build deps ─────────────────────────────
# Qt 5 core/GUI headers (qtbase5-dev) and the Boost C++ headers
# (libboost-dev) for agents building C++ projects that link against them.
# g++, gfortran and libfftw3-dev are already provided above
# (build-essential and the ham-radio block respectively).
RUN apt-get update && apt-get install -y --no-install-recommends \
      qtbase5-dev \
      libboost-dev \
    && rm -rf /var/lib/apt/lists/*

# ── OpenSCAD (programmatic 3D CAD) ─────────────────────────────────────
# The scriptable solid modeller agents use to turn .scad source into
# meshes. Geometry export (-o out.stl / .off / .3mf / .csg) runs through
# CGAL and needs no display. Image export (-o out.png) needs an OpenGL
# context, so xvfb is included: `xvfb-run -a openscad -o out.png in.scad`
# gives headless preview renders with no real display attached.
RUN apt-get update && apt-get install -y --no-install-recommends \
      openscad \
      xvfb \
    && rm -rf /var/lib/apt/lists/*

# ── ESP32 (Xtensa) firmware cross-compile build deps ──────────────────
# Native prerequisites ESP-IDF's CMake/Ninja bootstrap needs when
# esp-idf-sys builds the firmware (e.g. the blue-aspen-observatory panel).
# git, cmake, python3-venv/pip, pkg-config, wget, curl and libusb-1.0-0
# (via libusb-1.0-0-dev) are already provided above; these are the gaps.
# The Xtensa Rust toolchain + IDF itself are installed as the runtime user
# further down (they write HOME-relative artifacts).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ninja-build \
      flex \
      bison \
      gperf \
      ccache \
      libffi-dev \
      libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# ── sccache (shared Rust compiler cache) ──────────────────────────────────
# Companion to ccache (installed above): ccache caches the ESP-IDF C framework
# objects, sccache caches Rust compilation (build-std + crates) when the worker
# is run with RUSTC_WRAPPER=sccache. Both are content-hash keyed, so a toolchain
# or IDF bump invalidates them automatically. Only exercised when the controller
# mounts the shared build-cache PVC and sets the cache env vars (see
# runtime.controller.buildCache); with no cache mounted, sccache is simply
# unused. Pinned prebuilt binary (static musl) for a reproducible rebuild.
ARG SCCACHE_VERSION=0.8.2
RUN curl -fsSL -o /tmp/sccache.tar.gz \
       "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    && tar -xzf /tmp/sccache.tar.gz -C /tmp \
    && install -m 0755 "/tmp/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache" /usr/local/bin/sccache \
    && rm -rf /tmp/sccache.tar.gz "/tmp/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl" \
    && sccache --version

# ── Protobuf compiler (protoc) ────────────────────────────────────────
# Upstream release binary + the bundled well-known-type .proto files
# (google/protobuf/*.proto). Extracting the include/ tree to /usr/local
# means protoc auto-discovers the well-known types via its default
# "<binary>/../include" search path — no -I flag needed. Both the Go
# plugins (below) and Rust's prost/tonic build.rs invoke this protoc.
RUN curl -fsSL -o /tmp/protoc.zip \
       "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-x86_64.zip" \
    && unzip -q /tmp/protoc.zip bin/protoc 'include/*' -d /usr/local \
    && rm /tmp/protoc.zip \
    && chmod a+rx /usr/local/bin/protoc \
    && chmod -R a+rX /usr/local/include/google \
    && protoc --version

# ── Go toolchain + Go-based linters/debugger ──────────────────────────
COPY --from=multica-build /usr/local/go /usr/local/go
ENV GOROOT=/usr/local/go \
    GOPATH=/usr/local/gopath \
    GOBIN=/usr/local/gobin \
    PATH=/usr/local/gobin:/usr/local/go/bin:${PATH}
RUN mkdir -p "$GOPATH" "$GOBIN" \
    && go install github.com/go-delve/delve/cmd/dlv@latest \
    && go install golang.org/x/tools/gopls@latest \
    && go install honnef.co/go/tools/cmd/staticcheck@latest \
    && go install mvdan.cc/gofumpt@latest \
    && go install google.golang.org/protobuf/cmd/protoc-gen-go@latest \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest \
    && curl -fsSL "https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64.tar.gz" \
       | tar -xz -C /tmp \
    && mv "/tmp/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64/golangci-lint" /usr/local/bin/ \
    && rm -rf "/tmp/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64" \
    && chmod -R a+rX "$GOPATH" "$GOBIN" \
    && rm -rf /root/.cache/go-build

# ── Rust toolchain + linters/LSP + cargo-ndk + prost/tonic protoc plugins ─
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:${PATH}
RUN curl -fsSL https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile default --default-toolchain "${RUST_VERSION}" \
    && rustup component add clippy rustfmt rust-analyzer rust-src \
    && rustup target add \
         aarch64-linux-android \
         armv7-linux-androideabi \
         x86_64-linux-android \
         i686-linux-android \
    && cargo install --locked --version "${CARGO_NDK_VERSION}" cargo-ndk \
    && cargo install --locked protoc-gen-prost protoc-gen-prost-crate protoc-gen-tonic \
    && chmod -R a+rwX "$RUSTUP_HOME" "$CARGO_HOME" \
    && rm -rf /tmp/cargo-install*

# ── Kotlin compiler + ktlint ──────────────────────────────────────────
RUN curl -fsSL -o /tmp/kotlin.zip \
       "https://github.com/JetBrains/kotlin/releases/download/v${KOTLIN_VERSION}/kotlin-compiler-${KOTLIN_VERSION}.zip" \
    && unzip -q /tmp/kotlin.zip -d /opt \
    && rm /tmp/kotlin.zip \
    && ln -s /opt/kotlinc/bin/kotlinc /usr/local/bin/kotlinc \
    && ln -s /opt/kotlinc/bin/kotlin  /usr/local/bin/kotlin \
    && curl -fsSL -o /usr/local/bin/ktlint \
       "https://github.com/pinterest/ktlint/releases/download/${KTLINT_VERSION}/ktlint" \
    && chmod +x /usr/local/bin/ktlint

# ── Android SDK + NDK ─────────────────────────────────────────────────
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk
RUN mkdir -p "$ANDROID_HOME/cmdline-tools" \
    && curl -fsSL -o /tmp/cmdline-tools.zip \
       "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" \
    && unzip -q /tmp/cmdline-tools.zip -d "$ANDROID_HOME/cmdline-tools" \
    && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" \
    && rm /tmp/cmdline-tools.zip
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"
RUN yes | sdkmanager --licenses > /dev/null \
    && sdkmanager --install \
         "platform-tools" \
         "platforms;android-${ANDROID_PLATFORM_VERSION}" \
         "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
         "ndk;${ANDROID_NDK_VERSION}" \
    && chmod -R a+rX "$ANDROID_HOME"
ENV ANDROID_NDK_HOME=${ANDROID_HOME}/ndk/${ANDROID_NDK_VERSION} \
    ANDROID_NDK_ROOT=${ANDROID_HOME}/ndk/${ANDROID_NDK_VERSION}

# ── Node package managers via corepack ────────────────────────────────
RUN corepack enable \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate \
    && corepack prepare "yarn@stable" --activate

# ── pnpm install behavior for agent workers ───────────────────────────
# `pnpm install` in agent pods kept hanging on postinstall binary downloads
# (electron + playwright). Default the skip flags ON so a vanilla
# `pnpm install` completes inside a single agent turn. Tasks that genuinely
# need the binaries can unset the var and run `playwright install` /
# `electron-builder install-app-deps` explicitly.
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# ── Kubernetes CLI tooling (kubectl + helm) ───────────────────────────
RUN curl -fsSL "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
       -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && kubectl version --client \
    && curl -fsSL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
       | tar -xz -C /tmp \
    && mv /tmp/linux-amd64/helm /usr/local/bin/helm \
    && rm -rf /tmp/linux-amd64 \
    && chmod +x /usr/local/bin/helm \
    && helm version --short

# ── GitHub CLI (gh) ───────────────────────────────────────────────────
# Static binary from upstream releases. Agents that need GitHub-side actions
# (PR create/comment, issue ops) get gh on PATH. Auth is by GH_TOKEN env
# var injected from a K8s Secret at pod runtime — nothing baked in here.
RUN curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
       | tar -xz -C /tmp \
    && mv "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
    && rm -rf "/tmp/gh_${GH_VERSION}_linux_amd64" \
    && chmod +x /usr/local/bin/gh \
    && gh --version

# ── Cloudflare tooling (wrangler + rclone) ────────────────────────────
# wrangler drives the Cloudflare API (Workers, R2 bucket create/list, etc.);
# rclone is the S3-compatible mover for R2 object sync. Both authenticate
# purely from env vars injected from a K8s Secret at pod runtime — no creds
# baked in here (same model as GH_TOKEN above). wrangler reads
# CLOUDFLARE_API_TOKEN; rclone reads AWS_*/endpoint env or an --s3-* config.
RUN npm install -g "wrangler@${WRANGLER_VERSION}" \
    && npm cache clean --force \
    && curl -fsSL "https://github.com/rclone/rclone/releases/download/v${RCLONE_VERSION}/rclone-v${RCLONE_VERSION}-linux-amd64.zip" \
       -o /tmp/rclone.zip \
    && unzip -q /tmp/rclone.zip -d /tmp \
    && mv "/tmp/rclone-v${RCLONE_VERSION}-linux-amd64/rclone" /usr/local/bin/rclone \
    && rm -rf /tmp/rclone.zip "/tmp/rclone-v${RCLONE_VERSION}-linux-amd64" \
    && chmod +x /usr/local/bin/rclone \
    && wrangler --version \
    && rclone --version | head -1

# ── Terraform + pre-baked Cloudflare provider ─────────────────────────
# Terraform CLI from the upstream release zip. The Cloudflare provider
# (cloudflare/cloudflare) is pre-mirrored into a filesystem mirror so that
# `terraform init` resolves it locally instead of downloading from the
# registry at runtime — agents managing Cloudflare in air-gapped or
# quota-limited pods don't pay a fetch per job. A CLI config at
# /etc/terraform/terraformrc (wired via TF_CLI_CONFIG_FILE below) serves the
# cloudflare provider from the mirror and lets every other provider resolve
# `direct` from the registry as usual. Auth is via env vars injected from a
# K8s Secret at runtime (CLOUDFLARE_API_TOKEN etc.) — nothing baked in here.
RUN curl -fsSL -o /tmp/terraform.zip \
       "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip" \
    && unzip -q /tmp/terraform.zip -d /usr/local/bin \
    && rm /tmp/terraform.zip \
    && chmod +x /usr/local/bin/terraform \
    && terraform version \
    && mkdir -p /opt/terraform/plugin-mirror /tmp/tf-mirror /etc/terraform \
    && printf 'terraform {\n  required_providers {\n    cloudflare = {\n      source  = "cloudflare/cloudflare"\n      version = "%s"\n    }\n  }\n}\n' \
         "${TERRAFORM_CLOUDFLARE_PROVIDER_VERSION}" > /tmp/tf-mirror/versions.tf \
    && (cd /tmp/tf-mirror && terraform providers mirror -platform=linux_amd64 /opt/terraform/plugin-mirror) \
    && rm -rf /tmp/tf-mirror \
    && printf 'provider_installation {\n  filesystem_mirror {\n    path    = "/opt/terraform/plugin-mirror"\n    include = ["registry.terraform.io/cloudflare/cloudflare"]\n  }\n  direct {\n    exclude = ["registry.terraform.io/cloudflare/cloudflare"]\n  }\n}\n' > /etc/terraform/terraformrc \
    && chmod -R a+rX /opt/terraform /etc/terraform
ENV TF_CLI_CONFIG_FILE=/etc/terraform/terraformrc

# Non-root user the daemon and agents run as.
RUN groupadd -g 1001 multica \
    && useradd -m -u 1001 -g 1001 -s /bin/bash multica

COPY --from=multica-build /out/multica /usr/local/bin/multica

# Pre-trust github.com so `git clone` over ssh doesn't prompt.
RUN mkdir -p /home/multica/.ssh \
    && ssh-keyscan github.com > /home/multica/.ssh/known_hosts 2>/dev/null \
    && chown -R multica:multica /home/multica/.ssh \
    && chmod 700 /home/multica/.ssh \
    && chmod 644 /home/multica/.ssh/known_hosts

USER multica
WORKDIR /home/multica
ENV HOME=/home/multica \
    GOPATH=/home/multica/go \
    PATH=/home/multica/go/bin:/usr/local/cargo/bin:/usr/local/gobin:/usr/local/go/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}

# ── ESP32 Xtensa cross-compile toolchain (Espressif `esp` Rust + ESP-IDF) ─
# Cross-compile-only support for ESP32-S3 firmware. Stable rustc can't emit
# Xtensa, so espup installs Espressif's `esp` Rust toolchain + Xtensa LLVM
# (and a bundled xtensa-esp-elf GCC); ldproxy is the linker wrapper the
# xtensa-*-espidf target links through. Both are public downloads.
#
# Runs as the `multica` runtime user (not root) on purpose: espup writes
# ~/export-esp.sh and the pre-warmed ESP-IDF lands in ~/.espressif, both
# HOME-relative — baking them under /home/multica is where every runtime
# build looks. The `esp` rustup toolchain itself lands in the shared
# RUSTUP_HOME (/usr/local/rustup, left a+rwX by the Rust block above), and
# all agents run as this same user, so no extra chmod is needed.
#
# ESP_IDF_TOOLS_INSTALL_DIR=global makes esp-idf-sys/embuild reuse the
# pre-warmed ~/.espressif instead of a throwaway per-checkout .embuild dir
# (a plain env var overrides the firmware repo's cargo [env] default).
#
# LIBCLANG_PATH (bindgen needs it) and xtensa-esp-elf on PATH come from
# ~/export-esp.sh; it is sourced from the login/interactive shell profiles
# and via BASH_ENV, so non-interactive build shells (`bash -c 'make build'`)
# pick it up too.
#
# The first RUN (fatal) installs the pinned esp toolchain + ldproxy — the
# actual blocker, so a failure there fails the image build.
#
# The second RUN best-effort pre-warms the whole network-bound side of an
# ESP-IDF build so no agent task has to pay it. It clones the PUBLIC esp-idf
# repo at ESP_IDF_VERSION **with all submodules** into a persistent path
# (kept, not discarded) and runs install.sh to lay down the native toolchain
# (xtensa-esp-elf GCC + tools + python venv) under ~/.espressif. The submodule
# clone is the dominant cost measured in GRA-579 (still cloning at 24 min on a
# cold checkout), so baking it — source tree *and* submodules — is the biggest
# single win. esp-idf-sys's native builder honours IDF_PATH ("a user-provided
# local clone of the esp-idf, used instead of the one downloaded by the build
# script"), so at runtime it reuses this tree and never re-clones. We export
# IDF_PATH from export-esp.sh (sourced via BASH_ENV into build shells) **only
# on success** — that keeps the fallback clean: if the pre-warm fails we wipe
# the half-populated tree AND leave IDF_PATH unset, so esp-idf-sys clones to
# its own default location on the first build exactly as before. It still
# does NOT build the firmware repo: that repo is private and unreachable at
# image-build time (buildkit gets no GH creds). This step is non-fatal — a
# fetch hiccup must not break the whole runtime image.
#
# The third RUN pre-warms the cargo registry with the public esp-idf-* crates
# and embuild into the shared, baked CARGO_HOME (/usr/local/cargo). The
# firmware's exact lockfile can't be resolved here (private repo), so we fetch
# the public crates the firmware depends on; the registry index + crate sources
# then survive into every runtime build. Non-fatal for the same reason.
#
# espup, ldproxy and the esp Rust toolchain are pinned via ARG defaults
# (overridable with --build-arg) so a runtime rebuild is reproducible.
ARG ESPUP_VERSION=0.17.1
ARG LDPROXY_VERSION=0.3.5
ARG ESP_RUST_VERSION=1.97.0.0
ARG ESP_TARGET=esp32s3
ARG ESP_IDF_VERSION=v5.5.3
ARG ESP_IDF_PATH=/home/multica/.espressif/esp-idf
ENV ESP_IDF_TOOLS_INSTALL_DIR=global \
    BASH_ENV=/home/multica/export-esp.sh
RUN cargo install espup --locked --version "${ESPUP_VERSION}" \
    && cargo install ldproxy --locked --version "${LDPROXY_VERSION}" \
    && espup install \
         --toolchain-version "${ESP_RUST_VERSION}" \
         --targets "${ESP_TARGET}" \
         --export-file "$HOME/export-esp.sh" \
    && printf '\n. "$HOME/export-esp.sh"\n' >> "$HOME/.bashrc" \
    && printf '\n. "$HOME/export-esp.sh"\n' >> "$HOME/.profile"
RUN ( set -eux; \
      git clone -b "${ESP_IDF_VERSION}" --depth 1 --recurse-submodules --shallow-submodules \
        https://github.com/espressif/esp-idf.git "${ESP_IDF_PATH}" \
      && "${ESP_IDF_PATH}/install.sh" "${ESP_TARGET}" \
      && printf '\nexport IDF_PATH=%s\n' "${ESP_IDF_PATH}" >> "$HOME/export-esp.sh" ) \
      || { echo "WARN: ESP-IDF pre-warm failed; runtime bootstraps IDF on first build" >&2; rm -rf "${ESP_IDF_PATH}" "$HOME/.espressif"; }
# Cargo registry pre-warm: fetch the public esp-idf-* crates + embuild so the
# registry index and crate sources are baked into the shared CARGO_HOME. Uses a
# throwaway manifest; `cargo fetch` downloads without compiling (no esp
# toolchain needed). Non-fatal — a registry blip must not fail the image build.
RUN ( set -eux; \
      mkdir -p /tmp/esp-warm/src; \
      printf 'fn main() {}\n' > /tmp/esp-warm/src/main.rs; \
      printf '[package]\nname = "esp-warm"\nversion = "0.0.0"\nedition = "2021"\n\n[dependencies]\nesp-idf-svc = "0.51"\nesp-idf-hal = "0.45"\nesp-idf-sys = "0.36"\nembuild = "0.33"\n' \
        > /tmp/esp-warm/Cargo.toml; \
      cd /tmp/esp-warm && cargo fetch ) \
      || echo "WARN: esp crate registry pre-warm failed; runtime fetches crates on first build" >&2 \
    ; rm -rf /tmp/esp-warm

# Sanity: key tools resolve on PATH for the multica user.
RUN multica version || true \
    && go version \
    && dlv version \
    && golangci-lint --version \
    && rustc --version \
    && cargo --version \
    && cargo ndk --version \
    && rust-analyzer --version \
    && protoc --version \
    && protoc-gen-go --version \
    && protoc-gen-go-grpc --version \
    && command -v protoc-gen-prost \
    && command -v protoc-gen-prost-crate \
    && command -v protoc-gen-tonic \
    && javac -version \
    && kotlinc -version 2>&1 \
    && ktlint --version \
    && pnpm --version \
    && yarn --version \
    && sdkmanager --version \
    && test -d "$ANDROID_NDK_HOME" \
    && kubectl version --client \
    && helm version --short \
    && gh --version \
    && wrangler --version \
    && rclone version | head -1 \
    && terraform version \
    && test -d "/opt/terraform/plugin-mirror/registry.terraform.io/cloudflare/cloudflare" \
    && openscad --version 2>&1 | head -1 \
    && gfortran --version | head -1 \
    && autoconf --version | head -1 \
    && fltk-config --version \
    && pkg-config --exists fftw3f \
    && pkg-config --exists sndfile \
    && pkg-config --exists samplerate \
    && pkg-config --exists hamlib \
    && test -f "$HOME/export-esp.sh" \
    && . "$HOME/export-esp.sh" \
    && rustup toolchain list | grep -q '^esp' \
    && rustup run esp rustc --version \
    && command -v ldproxy > /dev/null \
    && command -v xtensa-esp-elf-gcc > /dev/null \
    && command -v ccache > /dev/null \
    && command -v sccache > /dev/null \
    && { test -d "$IDF_PATH/.git" \
           && echo "ESP-IDF source baked at $IDF_PATH" \
           || echo "WARN: ESP-IDF source not baked (pre-warm is best-effort; runtime bootstraps it)"; }
